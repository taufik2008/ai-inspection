# Port on which the Baileys server runs (e.g. 4000)
PORT=4000

# Directory where WhatsApp session authentication tokens are persisted
AUTH_DIR=./auth_info_baileys

# Webhook URL of your Vercel Next.js application to receive inbound messages & field photos
# Example: https://aqs-inspection.vercel.app/api/webhooks/whatsapp
WEBHOOK_URL=https://aqs-inspection.vercel.app/api/webhooks/whatsapp

# Optional Secret Token to protect API endpoints (matched with BAILEYS_API_SECRET in Next.js)
API_SECRET=
